# Telegram — من BotFather
BOT_TOKEN=ضع_رمز_البوت_هنا

# Supabase — استخدم المفتاح السري على الخادم فقط
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_ضع_المفتاح_هنا
# للتوافق مع المشاريع القديمة فقط، ولا يُنصح به لهذا الخادم الإداري:
# SUPABASE_SERVICE_ROLE_KEY=ضع_المفتاح_القديم_هنا
# SUPABASE_ANON_KEY=ضع_المفتاح_العام_هنا

# دخول لوحة الإدارة — admin/admin123 مقبولان محليًا فقط
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
FLASK_SECRET_KEY=غيّرني_إلى_سلسلة_عشوائية_طويلة_32_محرفًا_أو_أكثر

# التشغيل: polling محليًا، webhook على الإنترنت
APP_ENV=development
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=غيّرني_إلى_سر_عشوائي_16_محرفًا_أو_أكثر
SCHEDULER_SECRET=غيّرني_إلى_سر_عشوائي_16_محرفًا_أو_أكثر

